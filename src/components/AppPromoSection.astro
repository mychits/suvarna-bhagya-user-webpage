---
import { PLAY_STORE_URL } from "../data/navigation";

const features = [
  "Pay installments via UPI",
  "Download digital receipts",
  "Manage multiple schemes",
  "Live scheme progress tracking",
  "Transparent ledger view",
  "Timely payment reminders",
];
---

<section class="app-promo">
  <!-- Soft floating gold circles -->
  <div class="glow glow-one" aria-hidden="true"></div>
  <div class="glow glow-two" aria-hidden="true"></div>

  <div class="container promo-inner">
    <div class="promo-content">
      <span class="eyebrow rv" style="--d:0.1">— MOBILE APP</span>

      <h2 class="title">
        <span class="line">
          <span class="word"><span class="word-inner" style="--i:0">Manage</span></span>
          <span class="word"><span class="word-inner" style="--i:1">Your</span></span>
          <span class="word"><span class="word-inner" style="--i:2">Scheme</span></span>
        </span>
        <span class="line">
          <span class="word"><span class="word-inner shimmer" style="--i:3">Anytime,</span></span>
          <span class="word"><span class="word-inner shimmer" style="--i:4">Anywhere</span></span>
        </span>
      </h2>

      <p class="rv" style="--d:0.7">
        Join the Suvarna Bhagya Scheme, pay installments, track your progress,
        download receipts, and manage everything securely from the Mobile App.
      </p>

      <ul class="app-features">
        {features.map((text, i) => (
          <li class="rv rv-left" style={`--d:${(0.9 + i * 0.1).toFixed(2)}`}>
            <svg class="icon-svg icon-sm" viewBox="0 0 24 24">
              <path d="M5 13l4 4L19 7"></path>
            </svg>{" "}
            {text}
          </li>
        ))}
      </ul>

      <div class="download-actions">
        <a
          href={PLAY_STORE_URL}
          target="_blank"
          rel="noopener"
          class="store-badge rv rv-pop"
          style="--d:1.6"
        >
          <img
            src="/images/playstore.jpg"
            alt="Get it on Google Play"
            height="48"
          />
        </a>
      </div>
    </div>

    <div class="promo-image">
      <!-- Phone -->
      <div class="phone-slide rv rv-right" style="--d:0.3">
        <div class="phone-wrap">
          <img src="/images/mobile.png" alt="Suvarna Bhagya App" class="app-img" />
        </div>
      </div>

      <!-- QR code block -->
      <div class="qr-block rv" style="--d:1.4">
        <div class="qr-wrap">
          <img src="/images/QR.JPG" alt="Scan to Download" class="qr-img" />
        </div>
        <div class="qr-text">
          <strong>Scan to Download</strong>
          <p>Point your phone camera at the QR code to get the App</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>(".app-promo");

  if (section) {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    if (reduceMotion || !("IntersectionObserver" in window)) {
      // Show everything normally, no animation
      section.classList.add("is-visible");
    } else {
      // Hide first, then play when the section is scrolled into view
      section.classList.add("anim");

      const observer = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) {
            section.classList.add("is-visible");
            observer.disconnect();
          }
        },
        { threshold: 0.15, rootMargin: "0px 0px -8% 0px" }
      );

      observer.observe(section);
    }
  }
</script>

<style>
  .app-promo {
    position: relative;
    background-color: var(--color-burgundy);
    padding: 5rem 0;
    overflow: hidden;
    color: var(--color-ivory);
  }

  .promo-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  /* ---------- Background glow circles ---------- */
  .glow {
    position: absolute;
    border-radius: 50%;
    background: #d5ad32;
    opacity: 0.07;
    pointer-events: none;
  }
  .glow-one {
    width: 360px;
    height: 360px;
    top: -140px;
    left: -110px;
    animation: drift 10s ease-in-out infinite;
  }
  .glow-two {
    width: 260px;
    height: 260px;
    bottom: -100px;
    right: -70px;
    animation: drift 8s ease-in-out infinite reverse;
  }
  @keyframes drift {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(18px, -22px); }
  }

  /* ---------- Text ---------- */
  .eyebrow {
    color: var(--color-gold);
    font-size: 0.85rem;
    letter-spacing: 2px;
    font-weight: 600;
    display: block;
    margin-bottom: 1rem;
  }

  .promo-content h2 {
    color: var(--color-ivory);
    font-size: 2.5rem;
    line-height: 1.2;
    margin-bottom: 1.5rem;
  }

  .line {
    display: block;
  }

  /* Word-by-word reveal */
  .word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.15em;
    margin-bottom: -0.15em;
  }
  .word-inner {
    display: inline-block;
  }
  .anim .word-inner {
    transform: translateY(115%);
  }
  .anim.is-visible .word-inner {
    transform: none;
    transition: transform 0.85s cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: calc(var(--i) * 0.12s + 0.2s);
  }

  /* Moving gold shimmer on the second line */
  .shimmer {
    background: linear-gradient(
      90deg,
      #d5ad32 0%,
      #d5ad32 35%,
      #fff3c4 50%,
      #d5ad32 65%,
      #d5ad32 100%
    );
    background-size: 220% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    animation: shimmer 4s linear infinite;
  }
  @keyframes shimmer {
    from { background-position: 100% center; }
    to { background-position: -100% center; }
  }

  .promo-content p {
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 2rem;
  }

  /* ---------- Generic scroll reveal ---------- */
  .anim .rv {
    opacity: 0;
    transform: translateY(26px);
  }
  .anim .rv-left {
    transform: translateX(-30px);
  }
  .anim .rv-right {
    transform: translateX(70px);
  }
  .anim .rv-pop {
    transform: scale(0.7);
  }
  .anim.is-visible .rv {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.8s ease,
      transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: calc(var(--d, 0) * 1s);
  }

  /* ---------- Feature list ---------- */
  .app-features {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
    margin-bottom: 2.5rem;
  }
  .app-features li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    color: var(--color-ivory);
  }
  .app-features .icon-svg {
    color: var(--color-gold);
    flex-shrink: 0;
  }

  /* Check mark draws itself */
  .app-features path {
    stroke-dasharray: 22;
    stroke-dashoffset: 0;
  }
  .anim .app-features path {
    stroke-dashoffset: 22;
  }
  .anim.is-visible .app-features path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.6s ease;
    transition-delay: calc(var(--d, 0) * 1s + 0.3s);
  }

  /* ---------- Store badge ---------- */
  .download-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .store-badge {
    display: inline-block;
    border-radius: 8px;
  }
  .store-badge img {
    display: block;
    height: 48px;
    width: auto;
    border-radius: 8px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .store-badge:hover img {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
  }
  .is-visible .store-badge {
    animation: badgeGlow 3s ease-in-out 2.6s infinite;
  }
  @keyframes badgeGlow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(213, 173, 50, 0); }
    50% { box-shadow: 0 0 0 8px rgba(213, 173, 50, 0.22); }
  }

  /* ---------- Phone ---------- */
  .promo-image {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .phone-wrap {
    position: relative;
    animation: phoneFloat 6s ease-in-out infinite;
  }

  /* pulsing gold glow behind the phone */
  .phone-wrap::before {
    content: "";
    position: absolute;
    inset: -40px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(213, 173, 50, 0.3),
      transparent 65%
    );
    animation: glowPulse 3.5s ease-in-out infinite;
  }

  .app-img {
    position: relative;
    width: 100%;
    max-width: 280px;
    display: block;
    margin: 0 auto;
    border-radius: 28px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  }

  @keyframes phoneFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }
  @keyframes glowPulse {
    0%, 100% { opacity: 0.55; transform: scale(0.95); }
    50% { opacity: 1; transform: scale(1.05); }
  }

  /* ---------- QR block ---------- */
  .qr-block {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    padding: 0.8rem 1.2rem;
    max-width: 320px;
  }

  .qr-wrap {
    position: relative;
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border-radius: 6px;
    background: #fff;
    overflow: hidden;
  }
  .qr-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 4px;
    display: block;
  }

  /* scanning line */
  .qr-wrap::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, #d5ad32, transparent);
    box-shadow: 0 0 8px #d5ad32;
    opacity: 0;
  }
  .is-visible .qr-wrap::after {
    animation: qrScan 2.6s ease-in-out 2s infinite;
  }
  @keyframes qrScan {
    0% { top: 0; opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { top: calc(100% - 3px); opacity: 0; }
  }

  .qr-text strong {
    display: block;
    color: var(--color-gold);
    font-size: 0.9rem;
    margin-bottom: 2px;
  }
  .qr-text p {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    line-height: 1.3;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .promo-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .app-features {
      text-align: left;
      max-width: 400px;
      margin: 0 auto 2rem;
    }
    .download-actions {
      justify-content: center;
    }
    .promo-image {
      margin-top: 2rem;
    }
    .anim .rv-right {
      transform: translateY(50px);
    }
  }
  @media (max-width: 500px) {
    .promo-content h2 {
      font-size: 1.9rem;
    }
    .app-features {
      grid-template-columns: 1fr;
    }
    .qr-block {
      flex-direction: column;
      text-align: center;
    }
  }

  /* ---------- Reduced motion ---------- */
  @media (prefers-reduced-motion: reduce) {
    .glow,
    .shimmer,
    .phone-wrap,
    .phone-wrap::before,
    .store-badge,
    .qr-wrap::after {
      animation: none !important;
    }
  }
</style>
