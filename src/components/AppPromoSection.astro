---
import { PLAY_STORE_URL } from "../data/navigation";
---

<section class="app-promo">
  <div class="container promo-inner">
    <div class="promo-content">
      <span class="eyebrow">— MOBILE APP</span>
      <h2>
        Manage Your Scheme
        <br />
        Anytime, Anywhere
      </h2>
      <p>
        Join the Suvarna Bhagya Scheme, pay installments, track your progress,
        download receipts, and manage everything securely from the Mobile App.
      </p>

      <ul class="app-features">
        <li>
          <svg class="icon-svg icon-sm" viewBox="0 0 24 24">
            <path d="M5 13l4 4L19 7"></path>
          </svg>{" "}
          Pay installments via UPI
        </li>
        <li>
          <svg class="icon-svg icon-sm" viewBox="0 0 24 24">
            <path d="M5 13l4 4L19 7"></path>
          </svg>{" "}
          Download digital receipts
        </li>
        <li>
          <svg class="icon-svg icon-sm" viewBox="0 0 24 24">
            <path d="M5 13l4 4L19 7"></path>
          </svg>{" "}
          Manage multiple schemes
        </li>
        <li>
          <svg class="icon-svg icon-sm" viewBox="0 0 24 24">
            <path d="M5 13l4 4L19 7"></path>
          </svg>{" "}
          Live scheme progress tracking
        </li>
        <li>
          <svg class="icon-svg icon-sm" viewBox="0 0 24 24">
            <path d="M5 13l4 4L19 7"></path>
          </svg>{" "}
          Transparent ledger view
        </li>
        <li>
          <svg class="icon-svg icon-sm" viewBox="0 0 24 24">
            <path d="M5 13l4 4L19 7"></path>
          </svg>{" "}
          Timely payment reminders
        </li>
      </ul>

      <div class="download-actions">
        <a
          href={PLAY_STORE_URL}
          target="_blank"
          rel="noopener"
          class="store-badge"
        >
          <img
            src="/images/playstore.jpg"
            alt="Get it on Google Play"
            height="48"
          />
        </a>
        <!-- <a href="#" class="store-btn">
          <svg class="icon-svg" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" /></svg>
          <div class="store-text"><small>Download on the</small><strong>App Store</strong></div>
        </a> -->
      </div>
    </div>

    <div class="promo-image">
      <!-- Mobile mock: use the image WITHOUT white bg (transparent PNG or cropped) -->
      <img src="/images/mobile.png" alt="Suvarna Bhagya App" class="app-img" />

      <!-- QR code block -->
      <div class="qr-block">
        <img src="/images/QR.JPG" alt="Scan to Download" class="qr-img" />
        <div class="qr-text">
          <strong>Scan to Download</strong>
          <p>Point your phone camera at the QR code to get the App</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .app-promo {
    background-color: var(--color-burgundy); /* matches reference screenshot */
    padding: 5rem 0;
    overflow: hidden;
    color: var(--color-ivory);
  }
  .promo-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .eyebrow {
    color: var(--color-gold);
    font-size: 0.85rem;
    letter-spacing: 2px;
    font-weight: 600;
    display: block;
    margin-bottom: 1rem;
  }
  .promo-content h2 {
    color: var(--color-ivory);
    font-size: 2.5rem;
    line-height: 1.2;
    margin-bottom: 1.5rem;
  }
  .promo-content p {
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 2rem;
  }

  .app-features {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
    margin-bottom: 2.5rem;
  }
  .app-features li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    color: var(--color-ivory);
  }
  .app-features .icon-svg {
    color: var(--color-gold);
    flex-shrink: 0;
  }

  .download-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .store-btn {
    display: flex;
    align-items: center;
    background: #000;
    border: 1px solid #333;
    border-radius: 8px;
    padding: 0.6rem 1.2rem;
    color: #fff;
    transition:
      transform 0.3s,
      box-shadow 0.3s;
  }
  .store-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
  }
  .store-btn .icon-svg {
    width: 24px;
    height: 24px;
    margin-right: 10px;
  }
  .store-text {
    display: flex;
    flex-direction: column;
    text-align: left;
  }
  .store-text small {
    font-size: 0.6rem;
    color: #aaa;
    text-transform: uppercase;
  }
  .store-text strong {
    font-size: 1rem;
    font-weight: 600;
  }

  .promo-image {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  /* Mobile mock — no white bg, just the phone frame */
  .app-img {
    width: 100%;
    max-width: 280px;
    display: block;
    margin: 0 auto;
    border-radius: 28px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    /* If image still has white bg, use mix-blend-mode or a wrapper with transparent bg */
  }

  /* QR block */
  .qr-block {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    padding: 0.8rem 1.2rem;
    max-width: 320px;
  }
  .qr-img {
    width: 80px;
    height: 80px;
    object-fit: contain;
    border-radius: 6px;
    background: #fff;
    padding: 4px;
  }
  .qr-text strong {
    display: block;
    color: var(--color-gold);
    font-size: 0.9rem;
    margin-bottom: 2px;
  }
  .qr-text p {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    line-height: 1.3;
  }

  @media (max-width: 900px) {
    .promo-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .app-features {
      text-align: left;
      max-width: 400px;
      margin: 0 auto 2rem;
    }
    .download-actions {
      justify-content: center;
    }
    .promo-image {
      margin-top: 2rem;
    }
  }
  @media (max-width: 500px) {
    .promo-content h2 {
      font-size: 1.9rem;
    }
    .app-features {
      grid-template-columns: 1fr;
    }
    .qr-block {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
