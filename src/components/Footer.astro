---
import { PLAY_STORE_URL, ADMIN_CRM_URL } from "../data/navigation";
---

<footer class="site-footer">
  <!-- Background overlay -->
  <div class="footer-overlay"></div>

  <div class="container footer-main">
    <!-- CTA -->
    <div class="showroom-cta">
      <h2>Where Trust Meets Growth</h2>
      <a href="/contact" class="visit-btn">Visit Us Today</a>
    </div>

    <!-- LINKS GRID -->
    <div class="footer-links-grid">
      <div class="brand-col">
        <img src="/images/logo.avif" alt="Suvarna Bhagya" class="footer-logo" />
        <p>
          Crafting Contemporary Heritage Since 1992. A legacy built on trust,
          transparency, and timeless design.
        </p>
      </div>

      <div class="links-col">
        <h4>EXPLORE</h4>
        <ul>
          <li><a href="#">Collections</a></li>
          <li><a href="#">Bridal</a></li>
          <li><a href="#">Trending Collection</a></li>
        </ul>
      </div>

      <div class="links-col">
        <h4>ABOUT</h4>
        <ul>
          <li><a href="/about">Our Journey</a></li>
          <li><a href="/about">Our Foundation</a></li>
          <li><a href="/about">Our Protocol</a></li>
          <li><a href="/about">Our Mindset</a></li>
        </ul>
      </div>

      <div class="links-col">
        <h4>SERVICES</h4>
        <ul>
          <li><a href="/plans">Suvarna Bhagya</a></li>
          <li><a href="/contact">Book Consultation</a></li>
          <li><a href="/faq">FAQs</a></li>
        </ul>
      </div>

      <div class="links-col">
        <h4>CONNECT</h4>
        <ul>
          <li><a href="#">Instagram</a></li>
          <li><a href="#">Google</a></li>
          <li><a href="#">WhatsApp</a></li>
          <li><a href="/contact">Contact Us</a></li>
        </ul>
      </div>

      <div class="qr-col">
        <h4>GET THE APP</h4>
        <div class="qr-box">
          <img src="/images/QR.JPG" alt="Scan to Download" />
        </div>
        <a
          href={PLAY_STORE_URL}
          class="store-mini"
          target="_blank"
          rel="noopener"
          aria-label="Get it on Google Play"
        >
          <img
            src="/images/playstore.jpg"
            alt="Get it on Google Play"
            class="store-mini-icon"
          />
        </a>
      </div>
    </div>
  </div>

  <!-- BOTTOM BAR -->
  <div class="footer-bottom">
    <div class="container bottom-inner">
      <p>© {new Date().getFullYear()} ALL RIGHTS RESERVED BY SUVARNA BHAGYA.</p>

      <div class="legal-links">
        <a href="/privacy-policy">PRIVACY POLICY</a>
        <span class="sep">|</span>
        <a href="/terms">TERMS &amp; CONDITION</a>
        <!-- STEALTH ADMIN LINK -->
        <!-- <a href={ADMIN_CRM_URL} target="_blank" class="admin-link">Admin Login</a> -->
      </div>

      <p>CRAFTED AND DESIGNED BY SANJAY</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background-color: var(--color-burgundy-dark, #4a0a1d);
    color: #fff;
    padding-top: 5rem;
    overflow: hidden;
  }

  .footer-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(107, 15, 42, 0.85),
      rgba(74, 10, 29, 1)
    );
    z-index: 1;
  }

  .footer-main {
    position: relative;
    z-index: 2;
  }

  /* ---------- CTA ---------- */
  .showroom-cta {
    text-align: center;
    margin-bottom: 4.5rem;
  }

  .showroom-cta h2 {
    color: #fff;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.15;
    margin: 0 0 2rem;
    font-style: italic;
    font-weight: 400;
  }

  .visit-btn {
    display: inline-block;
    padding: 0.85rem 2.2rem;
    background: #fff;
    color: var(--color-burgundy, #780d2e);
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;
  }

  .visit-btn:hover {
    background: var(--color-gold, #d5ad32);
    transform: translateY(-2px);
  }

  /* ---------- Links grid ---------- */
  .footer-links-grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(4, 1fr) 1.2fr;
    gap: 2.5rem 2rem;
    align-items: start;
    padding-bottom: 3.5rem;
  }

  .brand-col p {
    color: #cca3b0;
    font-size: 0.9rem;
    margin: 1rem 0 0;
    line-height: 1.7;
    max-width: 320px;
  }

  .footer-logo {
    height: 40px;
    width: auto;
    display: block;
  }

  .links-col h4,
  .qr-col h4 {
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.85rem;
    letter-spacing: 1px;
    margin: 0 0 1.4rem;
    line-height: 1.2;
  }

  .links-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links-col li {
    margin-bottom: 0.8rem;
  }

  .links-col a {
    color: #cca3b0;
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.3s;
  }

  .links-col a:hover {
    color: var(--color-gold, #d5ad32);
  }

  /* ---------- QR + store ---------- */
  .qr-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .qr-box {
    width: 100px;
    height: 100px;
    background: #fff;
    padding: 5px;
    border-radius: 6px;
    margin-bottom: 1rem;
  }

  .qr-box img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    border-radius: 4px;
  }

  .store-mini {
    display: inline-block;
    line-height: 0;
  }

  .store-mini-icon {
    height: 42px;
    width: auto;
    display: block;
    border-radius: 6px;
  }

  /* ---------- Bottom bar ---------- */
  .footer-bottom {
    position: relative;
    z-index: 2;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.5rem 0;
    font-size: 0.7rem;
    color: #b08794;
  }

  .bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem 1.5rem;
    flex-wrap: wrap;
  }

  .bottom-inner p {
    margin: 0;
  }

  .legal-links {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .legal-links a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s;
  }

  .legal-links a:hover {
    color: #fff;
  }

  /* Stealth Admin Login */
  .admin-link {
    margin-left: 1rem;
    color: #7a2e45;
    transition: color 0.3s ease;
    font-weight: 600;
  }

  .admin-link:hover {
    color: var(--color-gold, #d5ad32);
  }

  /* ---------- Laptop / small desktop ---------- */
  @media (max-width: 1100px) {
    .footer-links-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .brand-col {
      grid-column: 1 / -1;
    }

    .brand-col p {
      max-width: 520px;
    }

    .qr-col {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem 1.5rem;
    }

    .qr-col h4 {
      width: 100%;
      margin-bottom: 0;
    }

    .qr-box {
      margin-bottom: 0;
    }
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 768px) {
    .site-footer {
      padding-top: 3.5rem;
    }

    .showroom-cta {
      margin-bottom: 3rem;
    }

    .footer-links-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1.5rem;
    }

    .bottom-inner {
      flex-direction: column;
      justify-content: center;
      text-align: center;
    }
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 480px) {
    .brand-col {
      text-align: center;
    }

    .footer-logo {
      margin: 0 auto;
    }

    .brand-col p {
      margin-left: auto;
      margin-right: auto;
    }

    .qr-col {
      justify-content: center;
      text-align: center;
    }

    .qr-col h4 {
      text-align: center;
    }

    .visit-btn {
      width: 100%;
      max-width: 280px;
    }
  }
</style>