---
---

<section class="about-section">
  <div class="container about-inner">

    <!-- ABOUT IMAGE -->
    <div class="about-image">
      <div class="image-placeholder">
        <img
          src="/images/Smart.avif"
          alt="Suvarna Bhagya Gold Savings Scheme"
          loading="lazy"
        />
      </div>

      <div class="image-overlay"></div>

      <div class="trust-badge">
        <strong><span data-count="30">30</span>+</strong>
        <span>YEARS OF TRUST</span>
      </div>

      <!-- <div class="image-accent"></div> -->
    </div>

    <!-- ABOUT CONTENT -->
    <div class="about-content">

      <div class="section-header left-align">
        <span class="eyebrow">— ABOUT THE SCHEME</span>

        <h2>
          Save Monthly.
          <span>Celebrate Your Golden Dreams.</span>
        </h2>
      </div>

      <p class="about-intro">
        Make your dream of owning gold come true with Suvarna Bhagya, a special
        gold purchase savings scheme designed to help you save systematically
        and enjoy exclusive benefits.
      </p>

      <!-- <p  >
        Suvarna Bhagya is a thoughtfully designed Gold Savings Scheme
        that helps you plan your dream jewellery purchase through
        convenient monthly installments. Save systematically and
        make your special occasions more rewarding.
      </p> -->

      <p class="about-description">
        Choose flexible monthly savings starting from ₹1,000 and
        redeem your accumulated benefits for your preferred
        hallmark jewellery, with 0% wastage and no hidden
        making charges as per applicable scheme conditions.
      </p>

      <p>
        With transparent transactions, secure digital records,
        timely reminders, and dedicated customer support,
        Suvarna Bhagya makes your gold savings journey
        convenient and rewarding.
      </p>

      <!-- SCHEME HIGHLIGHTS -->
      <div class="tags">
        <span>Monthly Savings</span>
        <span>Prompt Payer Bonus</span>
        <span>14 Installments</span>
        <!-- <span>Gold Jewellery Redemption</span> -->
      </div>

      <!-- JOINING GIFT -->
      <div class="gift-note">
        <div class="gift-note-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 12 20 22 4 22 4 12"></polyline>
            <rect x="2" y="7" width="20" height="5"></rect>
            <line x1="12" y1="22" x2="12" y2="7"></line>
            <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
            <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
          </svg>
        </div>
        <strong>A Special Joining Gift for Every Subscriber!</strong>
      </div>

    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('.about-section');

  if (section) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const counter = section.querySelector<HTMLElement>('[data-count]');
    const target = Number(counter?.dataset.count ?? 0);

    // Count "30" up from 0 when the badge appears
    const runCounter = () => {
      if (!counter) return;
      const delay = 600;
      const duration = 1500;
      const start = performance.now() + delay;

      const tick = (now: number) => {
        if (now < start) {
          requestAnimationFrame(tick);
          return;
        }
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        counter.textContent = String(Math.round(target * eased));
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    if (reduceMotion || !('IntersectionObserver' in window)) {
      // Show everything normally, no animation
      section.classList.add('is-visible');
    } else {
      // Hide first, then play the animations when the section is scrolled into view
      section.classList.add('anim');
      if (counter) counter.textContent = '0';

      const observer = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) {
            section.classList.add('is-visible');
            runCounter();
            observer.disconnect();
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
      );

      observer.observe(section);
    }
  }
</script>

<style>
  /* MAIN SECTION */

  .about-section {
    padding: 8rem 0;
    background: var(--color-ivory);
    overflow: hidden;
  }

  .about-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  /* IMAGE */

  .about-image {
    position: relative;
    isolation: isolate;
  }

  .image-placeholder {
    width: 100%;
    height: 550px;
    background: #f2e3d5;
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 20px 50px rgba(76, 24, 32, 0.12);
  }

  .image-placeholder img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 20px;
    transition: transform 0.8s ease;
  }

  .about-image:hover .image-placeholder img {
    transform: scale(1.06);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    border-radius: 20px;
    background: linear-gradient(
      180deg,
      transparent 60%,
      rgba(60, 12, 25, 0.12)
    );
    pointer-events: none;
  }

  .image-accent {
    position: absolute;
    width: 140px;
    height: 140px;
    border: 2px solid var(--color-gold);
    border-radius: 20px;
    bottom: -18px;
    left: -18px;
    z-index: -1;
    opacity: 0.6;
  }

  /* TRUST BADGE */

  .trust-badge {
    position: absolute;
    bottom: -25px;
    right: -20px;
    background: var(--color-burgundy);
    color: #fff;
    padding: 1.5rem 2rem;
    border-radius: 12px;
    text-align: center;
    box-shadow: 0 12px 30px rgba(107, 15, 42, 0.3);
    z-index: 3;
  }

  .trust-badge strong {
    display: block;
    font-size: 2.3rem;
    font-family: var(--font-heading);
    color: var(--color-gold);
    line-height: 1.2;
    font-variant-numeric: lining-nums;
  }

  .trust-badge span {
    font-size: 0.7rem;
    letter-spacing: 1.5px;
  }

  .trust-badge strong span {
    font-size: inherit;
    letter-spacing: normal;
  }

  /* TEXT CONTENT */

  .section-header.left-align {
    text-align: left;
    margin-bottom: 1.8rem;
  }

  .section-header.left-align .eyebrow {
    justify-content: flex-start;
    display: inline-flex;
    color: #997329;
    letter-spacing: 2px;
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .section-header.left-align .eyebrow::before {
    display: none;
  }

  .section-header.left-align h2 {
    font-size: 2.7rem;
    line-height: 1.25;
    margin-bottom: 0;
    color: var(--color-burgundy);
  }

  .section-header.left-align h2 span {
    display: block;
    color: #a77d29;
  }

  .about-content p {
    color: var(--color-text-light);
    margin-bottom: 1.2rem;
    font-size: 1.02rem;
    line-height: 1.85;
  }

  .about-description {
    font-weight: 500;
  }

  .about-content .about-intro {
    font-size: 1.12rem;
    font-weight: 600;
    color: var(--color-burgundy);
  }

  /* JOINING GIFT NOTE */

  .gift-note {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.6rem;
    padding: 0.9rem 1.2rem;
    background: #fdf8eb;
    border: 1px solid rgba(180, 137, 49, 0.3);
    border-left: 3px solid var(--color-gold);
    border-radius: 0 10px 10px 0;
  }

  .gift-note-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-burgundy);
    color: var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    transform-origin: 50% 90%;
  }

  .gift-note-icon svg {
    width: 20px;
    height: 20px;
  }

  .gift-note strong {
    color: var(--color-burgundy);
    font-size: 0.95rem;
    line-height: 1.4;
  }

  /* SCHEME TAGS */

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.8rem;
  }

  .tags span {
    background: #f7eedc;
    border: 1px solid rgba(180, 137, 49, 0.2);
    color: #8c6825;
    padding: 0.65rem 1rem;
    border-radius: 30px;
    font-size: 0.78rem;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .tags span:hover {
    background: var(--color-burgundy);
    color: #fff;
    border-color: var(--color-burgundy);
    transform: translateY(-4px);
  }

  /* EXPLORE PLANS BUTTON */

  .about-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 2rem;
    color: var(--color-burgundy);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid var(--color-gold);
    padding-bottom: 7px;
    transition: color 0.3s ease;
  }

  .about-arrow {
    width: 22px;
    height: 22px;
    display: inline-flex;
    transition: transform 0.3s ease;
  }

  .about-arrow svg {
    width: 100%;
    height: 100%;
  }

  .about-link:hover {
    color: #a77d29;
  }

  .about-link:hover .about-arrow {
    transform: translateX(6px);
  }

  /* ---------- SCROLL ANIMATIONS ----------
     .anim       = added by script: hides things before the section is seen
     .is-visible = added when scrolled into view: plays the animations
  ---------------------------------------- */

  .anim .about-image,
  .anim .about-content,
  .anim .trust-badge,
  .anim .tags span,
  .anim .gift-note {
    opacity: 0;
  }

  .is-visible .about-image,
  .is-visible .about-content,
  .is-visible .trust-badge,
  .is-visible .tags span,
  .is-visible .gift-note {
    opacity: 1;
  }

  .is-visible .gift-note {
    animation: tagEntrance 0.7s ease 1.1s backwards;
  }

  .is-visible .gift-note-icon {
    animation: giftWiggle 4s ease-in-out 2.4s infinite;
  }

  @keyframes giftWiggle {
    0%, 82%, 100% { transform: rotate(0); }
    86% { transform: rotate(-12deg) scale(1.1); }
    90% { transform: rotate(10deg) scale(1.1); }
    94% { transform: rotate(-6deg); }
  }

  .is-visible .about-image {
    animation: imageEntrance 1s ease backwards;
  }

  .is-visible .about-content {
    animation: contentEntrance 0.9s ease 0.15s backwards;
  }

  .is-visible .trust-badge {
    animation:
      badgePop 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) 0.6s backwards,
      badgeFloat 4s ease-in-out 1.3s infinite;
  }

  .is-visible .tags span {
    animation: tagEntrance 0.6s ease backwards;
  }

  .is-visible .tags span:nth-child(1) { animation-delay: 0.5s; }
  .is-visible .tags span:nth-child(2) { animation-delay: 0.65s; }
  .is-visible .tags span:nth-child(3) { animation-delay: 0.8s; }
  .is-visible .tags span:nth-child(4) { animation-delay: 0.95s; }

  @keyframes imageEntrance {
    from {
      opacity: 0;
      transform: translateX(-45px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes contentEntrance {
    from {
      opacity: 0;
      transform: translateX(45px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes badgePop {
    from {
      opacity: 0;
      transform: scale(0.6) translateY(20px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes badgeFloat {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-9px);
    }
  }

  @keyframes tagEntrance {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* TABLET */

  @media (max-width: 900px) {
    .about-section {
      padding: 5rem 0;
    }

    .about-inner {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .image-placeholder {
      height: 480px;
    }

    .trust-badge {
      right: 15px;
    }

    .image-accent {
      left: 0;
    }

    .section-header.left-align h2 {
      font-size: 2.4rem;
    }
  }

  /* MOBILE */

  @media (max-width: 550px) {
    .about-section {
      padding: 4rem 0;
    }

    .image-placeholder {
      height: 350px;
    }

    .trust-badge {
      padding: 1rem 1.4rem;
      bottom: -18px;
      right: 10px;
    }

    .trust-badge strong {
      font-size: 1.8rem;
    }

    .section-header.left-align h2 {
      font-size: 2rem;
    }

    .about-content p {
      font-size: 0.95rem;
      line-height: 1.75;
    }

    .tags {
      gap: 0.55rem;
    }

    .tags span {
      font-size: 0.7rem;
      padding: 0.55rem 0.8rem;
    }
  }

  /* REDUCED MOTION */

  @media (prefers-reduced-motion: reduce) {
    .about-section *,
    .about-section *::before,
    .about-section *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>