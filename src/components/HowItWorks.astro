---
// Using SVG paths for icons
const steps = [
  { n: '01', t: 'Download App', d: 'Get the App from Play Store', icon: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z' },
  { n: '02', t: 'Register & Login', d: 'Create account in minutes', icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' },
  { n: '03', t: 'Complete KYC', d: 'Quick and fully digital', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  { n: '04', t: 'Choose Scheme', d: 'Weight or Amount based', icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
  { n: '05', t: 'Select Duration', d: 'Pick 10+1 or 22 months', icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' },
  { n: '06', t: 'Set Installment', d: 'Start from ₹1,000', icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z' },
  { n: '07', t: 'Pay First Installment', d: 'Scheme activates instantly', icon: 'M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z' },
  { n: '08', t: 'Track Progress', d: 'Monitor savings in real-time', icon: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6' },
  { n: '09', t: 'Redeem Jewellery', d: 'Shop at scheme maturity', icon: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z' },
];
---

<section class="how-it-works">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">— STEP BY STEP —</span>
      <h2>How It Works</h2>
    </div>
    
    <div class="steps-grid">
      {steps.map((s) => (
        <div class="step">
          <div class="step-icon-wrap">
            <svg class="icon-svg" viewBox="0 0 24 24"><path d={s.icon}></path></svg>
          </div>
          <h4><span class="step-num">{s.n}</span> {s.t}</h4>
          <p>{s.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .how-it-works { padding: 4rem 0; background: #fff; }

.section-header {
  text-align: center;
  margin-bottom: 3rem;
}
 .section-header .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-gold, #d4a937);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 2.5px;
  }
  .section-header::before {
    content: '';
    width: 16px;
    height: 1px;
    background: var(--color-gold, #d4a937);
  }

.steps-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem 1rem;
  text-align: center;
}

.step {
  padding: 1rem;
  border-radius: 12px;
  transition: transform 0.35s ease, background 0.35s ease, box-shadow 0.35s ease;
  animation: fadeUp 0.6s ease both;
}
.step:nth-child(1) { animation-delay: 0.05s; }
.step:nth-child(2) { animation-delay: 0.10s; }
.step:nth-child(3) { animation-delay: 0.15s; }
.step:nth-child(4) { animation-delay: 0.20s; }
.step:nth-child(5) { animation-delay: 0.25s; }
.step:nth-child(6) { animation-delay: 0.30s; }
.step:nth-child(7) { animation-delay: 0.35s; }
.step:nth-child(8) { animation-delay: 0.40s; }
.step:nth-child(9) { animation-delay: 0.45s; }

.step:hover {
  transform: translateY(-6px);
  background: #fdf8f8;
  box-shadow: 0 10px 25px rgba(128, 0, 32, 0.08);
}

.step:hover .step-icon-wrap {
  border-color: var(--color-gold);
  background: var(--color-burgundy);
  color: var(--color-gold);
  transform: scale(1.12);
}

.step-icon-wrap {
  width: 60px; height: 60px;
  border: 1px solid #e0d5c1;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 1rem;
  position: relative;
  background: #fdfcfb;
  color: var(--color-burgundy);
  transition: all 0.35s ease;
}
.step-icon-wrap .icon-svg { width: 24px; height: 24px; transition: color 0.35s; }

.step-icon-wrap::after {
  content: '';
  position: absolute;
  top: 50%; right: -60%;
  width: 100%; height: 1px;
  background: #eee;
  z-index: -1;
}
.step:nth-child(3n) .step-icon-wrap::after { display: none; }

.step h4 {
  font-family: var(--font-body);
  font-size: 0.95rem;
  color: var(--color-burgundy);
  margin-bottom: 0.3rem;
  font-weight: 600;
}
.step-num {
  color: var(--color-gold);
  font-family: var(--font-heading);
  font-size: 1rem;
  margin-right: 3px;
}
.step p { font-size: 0.8rem; color: var(--color-text-light); }

@media (max-width: 768px) {
  .steps-grid { grid-template-columns: 1fr 1fr; }
  .section-header h2 { font-size: 1.8rem; }
  .step:nth-child(2n) .step-icon-wrap::after { display: none; }
  .step:nth-child(3n) .step-icon-wrap::after { display: block; right: -60%; }
  .step:nth-child(even) .step-icon-wrap::after { display: none; }
}
@media (max-width: 500px) {
  .steps-grid { grid-template-columns: 1fr; }
  .step-icon-wrap::after { display: none !important; }
}
</style>