    </div>
    
    <div class="help-grid">
      <a href="tel:+916351630432" class="help-card">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </div>
        <h3>Call Us</h3>
        <p>+91 63516 30432</p>
      </a>
      
      <a href="https://wa.me/916351630432" target="_blank" class="help-card">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </div>
        <h3>WhatsApp Us</h3>
        <p>Quick replies - 9 AM – 8 PM</p>
      </a>
      
      <a href="/contact" class="help-card">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </div>
        <h3>Book Appointment</h3>
        <p>Meet our scheme advisors</p>
      </a>
      
      <a href="/contact" class="help-card">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </div>
        <h3>Visit Showroom</h3>
        <p>Waghavadi Road, Bhavnagar</p>
      </a>
    </div>
  </div>
</section>

<style>
  .help-section { padding: 6rem 0; background-color: var(--color-ivory); }

  .section-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 4rem;
  }
  .eyebrow {
    color: var(--color-gold-dark);
    font-size: 0.85rem;
    letter-spacing: 2px;
    font-weight: 600;
    display: block;
    margin-bottom: 0.5rem;
  }
  .section-header h2 { font-size: 2.5rem; margin-bottom: 1rem; color: var(--color-burgundy); }
  .section-header p { color: #555; }

  .help-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .help-card {
    background: #fff;
    padding: 2rem;
    border-radius: 10px;
    text-align: center;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
    border: 1px solid #eee;
    animation: fadeUp 0.6s ease both;
  }
  .help-card:nth-child(1) { animation-delay: 0.05s; }
  .help-card:nth-child(2) { animation-delay: 0.10s; }
  .help-card:nth-child(3) { animation-delay: 0.15s; }
  .help-card:nth-child(4) { animation-delay: 0.20s; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .help-card:hover {
    transform: translateY(-8px) scale(1.02);
    border-color: var(--color-gold);
    box-shadow: 0 16px 32px rgba(128, 0, 32, 0.12);
  }

  .help-card:hover .icon {
    transform: scale(1.2) rotate(-5deg);
    color: var(--color-burgundy);
  }

  .icon {
    width: 48px; height: 48px;
    margin: 0 auto 1rem;
    display: flex; align-items: center; justify-content: center;
    background: #fdf2eb;
    border-radius: 50%;
    color: var(--color-gold-dark);
    transition: all 0.35s ease;
  }
  .icon svg { width: 24px; height: 24px; }

  .help-card h3 { font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--color-charcoal); }
  .help-card p { font-size: 0.85rem; color: #666; margin: 0; }
</style>