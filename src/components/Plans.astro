---
import { plans } from '../data/plans';
---

<section class="plans-section">
  <div class="container">
    <div class="section-header">
      <h2>Choose Your Savings Plan</h2>
      <p>Select a plan that fits your financial goals. Illustrative figures only.</p>
    </div>
    <div class="plans-grid">
      {plans.map((plan) => (
        <div class="plan-card">
          <h3>{plan.name}</h3>
          <div class="price">{plan.monthly}<span>/month</span></div>
          <ul class="plan-features">
            <li><strong>Term:</strong> {plan.term}</li>
            <li><strong>Total:</strong> {plan.total}</li>
            {plan.features.map(feature => <li>{feature}</li>)}
          </ul>
          <a href="/register" class="btn-primary plan-btn">Select Plan</a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Keep the styles from the previous step here */
  .plans-section { padding: 6rem 0; background-color: var(--color-ivory); }
  .section-header { text-align: center; margin-bottom: 4rem; }
  .section-header h2 { font-size: 2.5rem; color: var(--color-charcoal); }
  .plans-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; }
  .plan-card { background: #fff; padding: 2.5rem 2rem; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); text-align: center; border-top: 4px solid var(--color-gold); transition: transform 0.3s ease; }
  .plan-card:hover { transform: translateY(-5px); }
  .plan-card h3 { font-size: 1.5rem; color: var(--color-charcoal); margin-bottom: 1rem; }
  .price { font-size: 2.5rem; font-weight: 700; color: var(--color-gold-dark); margin-bottom: 2rem; }
  .price span { font-size: 1rem; color: var(--color-grey); font-weight: 400; }
  .plan-features { list-style: none; margin-bottom: 2rem; text-align: left; }
  .plan-features li { padding: 0.5rem 0; border-bottom: 1px solid #eee; color: #555; }
  .plan-btn { width: 100%; }
</style>