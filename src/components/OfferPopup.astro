---
// Put your image in the /public folder and change this path.
// Example: /public/offer-banner.png  ->  "/offer-banner.png"
const offerImage = "/offer-banner.png";

const decorations = Array.from({ length: 24 }, (_, i) => ({
  left: `${(i * 37 + 11) % 100}%`,
  delay: `${(i % 8) * 0.7}s`,
  duration: `${5 + (i % 5)}s`,
  size: `${10 + (i % 4) * 5}px`,
}));
---

<div class="offer-overlay" id="offerOverlay" aria-hidden="true">

  <!-- Falling gold decorations -->
  <div class="gold-rain" aria-hidden="true">
    {decorations.map((item) => (
      <span
        class="gold-particle"
        style={`--left:${item.left}; --delay:${item.delay}; --duration:${item.duration}; --size:${item.size};`}
      >
        ✦
      </span>
    ))}
  </div>

  <!-- Popup (horizontal rectangle) -->
  <div
    class="offer-popup"
    role="dialog"
    aria-modal="true"
    aria-labelledby="offerTitle"
    tabindex="-1"
  >
    <button class="close-btn" id="closeOffer" aria-label="Close offer">×</button>

    <!-- LEFT PANEL : big offer -->
    <div class="offer-left">
      <!-- Image slot: hides itself automatically if the file is missing -->
      <img class="offer-image" src={offerImage} alt="Special joining offer" />

      <div class="left-glow"></div>

      <svg class="gift-art" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="20 12 20 22 4 22 4 12"></polyline>
        <rect x="2" y="7" width="20" height="5"></rect>
        <line x1="12" y1="22" x2="12" y2="7"></line>
        <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
        <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
      </svg>

      <p class="left-label">SPECIAL JOINING OFFER</p>
      <div class="discount-value">50% OFF</div>
      <p class="left-sub">On Making Charges</p>
      <div class="left-divider"></div>
      <div class="wastage">+ 0% WASTAGE</div>
    </div>

    <!-- RIGHT PANEL : details -->
    <div class="offer-right">

      <div class="brand-label">
        <svg class="brand-star" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2l2.4 7.1L22 12l-7.6 2.9L12 22l-2.4-7.1L2 12l7.6-2.9L12 2z" />
        </svg>
        SUVARNA BHAGYA
        <svg class="brand-star" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2l2.4 7.1L22 12l-7.6 2.9L12 22l-2.4-7.1L2 12l7.6-2.9L12 2z" />
        </svg>
      </div>
      <div class="gold-divider"></div>

      <p class="small-heading">SPECIAL JOINING BENEFITS</p>

      <h2 id="offerTitle">Make Your Gold Dreams Come True!</h2>

      <p class="subtitle">Join Suvarna Bhagya Jewellery Purchase Plan</p>

      <div class="offer-list">
        <div class="offer-card">
          <div class="offer-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 12 20 22 4 22 4 12"></polyline>
              <rect x="2" y="7" width="20" height="5"></rect>
              <line x1="12" y1="22" x2="12" y2="7"></line>
              <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
              <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
            </svg>
          </div>
          <div>
            <h3>FREE GIFT</h3>
            <p>At the Time of Joining</p>
          </div>
        </div>

        <div class="offer-card">
          <div class="offer-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M8.5 8h7"></path>
              <path d="M8.5 11.5h7"></path>
              <path d="M9 8c3.5 0 5 1.5 5 3.5S12.5 15 9 15h-.5l5.5 4"></path>
            </svg>
          </div>
          <div>
            <h3>EXTRA BONUS</h3>
            <p>Bonus on Your Instalment Paid*</p>
          </div>
        </div>
      </div>

      <p class="footer-message">Save Today. Shine Tomorrow.</p>

      <a href="/plans" class="know-more-btn">
        EXPLORE OUR PLANS <span>→</span>
      </a>

      <p class="terms">*Terms and conditions apply</p>
    </div>
  </div>
</div>

<script>
  const overlay = document.querySelector("#offerOverlay");
  const popup = overlay?.querySelector<HTMLElement>(".offer-popup");
  const closeButton = document.querySelector("#closeOffer");

  if (overlay && popup && closeButton) {
    // If the image file is missing/broken, hide it so the default design shows
    const offerImg = overlay.querySelector<HTMLImageElement>(".offer-image");
    if (offerImg) {
      const markMissing = () => offerImg.classList.add("is-missing");
      offerImg.addEventListener("error", markMissing);
      if (offerImg.complete && offerImg.naturalWidth === 0) markMissing();
    }

    // Shows on every page load / refresh, after 1 second
    const showPopup = () => {
      setTimeout(() => {
        overlay.classList.add("is-visible");
        overlay.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        popup.focus();
      }, 1000);
    };

    const closePopup = () => {
      overlay.classList.remove("is-visible");
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };

    showPopup();

    closeButton.addEventListener("click", closePopup);

    overlay.addEventListener("click", (event) => {
      if (event.target === overlay) closePopup();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && overlay.classList.contains("is-visible")) {
        closePopup();
      }
    });
  }
</script>

<style>
  /* ---------- Overlay ---------- */
  .offer-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(12, 8, 12, 0.78);
    backdrop-filter: blur(9px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease, visibility 0.5s ease;
    overflow: hidden;
  }

  .offer-overlay.is-visible {
    opacity: 1;
    visibility: visible;
  }

  /* ---------- Popup: horizontal rectangle ---------- */
  .offer-popup {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    width: min(100%, 860px);
    max-height: 90vh;
    overflow: hidden;
    border: 3px solid #d6a333;
    border-radius: 18px;
    background: #fff9e8;
    box-shadow:
      0 0 25px rgba(255, 193, 55, 0.5),
      0 20px 80px rgba(0, 0, 0, 0.5);
    transform: translateY(-70px) scale(0.85);
    transition: transform 0.65s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .is-visible .offer-popup {
    transform: translateY(0) scale(1);
  }

  .close-btn {
    position: absolute;
    top: 12px;
    right: 14px;
    z-index: 5;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 50%;
    background: #68100d;
    color: #fff;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }

  /* ---------- Left panel ---------- */
  .offer-left {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 36px 24px;
    text-align: center;
    color: #fff5cc;
    background: linear-gradient(150deg, #650b0b, #a51c16 55%, #650b0b);
    overflow: hidden;
  }

  /* Image fills the whole left panel; hidden if file is missing */
  .offer-image {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .offer-image.is-missing {
    display: none;
  }

  .left-glow {
    position: absolute;
    top: -60px;
    left: 50%;
    width: 280px;
    height: 280px;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(255, 211, 77, 0.35), transparent 65%);
    pointer-events: none;
  }

  .gift-art {
    position: relative;
    width: 76px;
    height: 76px;
    margin-bottom: 14px;
    color: #ffdf69;
    filter: drop-shadow(0 0 10px rgba(255, 189, 34, 0.6));
  }

  .left-label {
    position: relative;
    margin: 0 0 6px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 3px;
    color: #e5b94e;
  }

  .discount-value {
    position: relative;
    font-size: clamp(38px, 5vw, 52px);
    font-weight: 900;
    line-height: 1.1;
    color: #ffdf69;
  }

  .left-sub {
    position: relative;
    margin: 4px 0 0;
    font-size: 17px;
  }

  .left-divider {
    width: 70px;
    height: 2px;
    margin: 16px auto 14px;
    background: linear-gradient(90deg, transparent, #e5b94e, transparent);
  }

  .wastage {
    position: relative;
    font-size: 22px;
    font-weight: 900;
    color: #ffdf69;
  }

  /* ---------- Right panel ---------- */
  .offer-right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 30px 38px 22px;
    text-align: center;
    color: #68100d;
    background: linear-gradient(145deg, #fff9e8, #ffe9b0 60%, #fff6df);
    overflow-y: auto;
  }

  .brand-label {
    font-size: 20px;
    font-weight: 900;
    letter-spacing: 2px;
    color: #7d160f;
  }

  .gold-divider {
    width: 90px;
    height: 3px;
    margin: 10px auto;
    background: linear-gradient(90deg, transparent, #c58b17, transparent);
  }

  .small-heading {
    margin: 0;
    color: #a36c09;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 3px;
  }

  #offerTitle {
    margin: 10px 0 6px;
    font-family: Georgia, serif;
    font-size: clamp(22px, 2.6vw, 28px);
    line-height: 1.2;
    color: #78130e;
  }

  .subtitle {
    margin: 0 0 16px;
    font-size: 13px;
    color: #75502b;
  }

  .offer-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .offer-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 16px;
    text-align: left;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid #e0b85d;
    border-radius: 10px;
    box-shadow: 0 4px 12px rgba(125, 70, 0, 0.08);
  }

  .offer-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, #7d160f, #a51c16);
    color: #ffdf69;
    box-shadow: 0 3px 8px rgba(100, 10, 10, 0.25);
  }

  .offer-icon svg {
    width: 22px;
    height: 22px;
  }

  .brand-star {
    display: inline-block;
    width: 16px;
    height: 16px;
    margin: 0 6px;
    vertical-align: -1px;
    color: #c58b17;
  }

  .offer-card h3 {
    margin: 0 0 3px;
    font-size: 16px;
    color: #9a5700;
  }

  .offer-card p {
    margin: 0;
    font-size: 13px;
    color: #68100d;
  }

  .footer-message {
    margin: 16px 0 12px;
    font-family: Georgia, serif;
    font-style: italic;
    font-size: 17px;
    font-weight: bold;
  }

  .know-more-btn {
    align-self: center;
    display: inline-block;
    padding: 11px 28px;
    border: 1px solid #a96d0d;
    border-radius: 30px;
    background: linear-gradient(135deg, #ffda64, #d69a20);
    color: #67110d;
    font-size: 14px;
    font-weight: 900;
    text-decoration: none;
    transition: 0.3s;
  }

  .know-more-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 18px #c38b3d66;
  }

  .terms {
    margin: 10px 0 0;
    font-size: 10px;
    color: #806b4e;
  }

  /* ---------- Falling gold particles ---------- */
  .gold-rain {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .gold-particle {
    position: absolute;
    top: -40px;
    left: var(--left);
    font-size: var(--size);
    color: #ffd34d;
    text-shadow: 0 0 12px #ffbd22;
    opacity: 0.9;
    animation: goldFall var(--duration) linear var(--delay) infinite;
  }

  @keyframes goldFall {
    0% {
      transform: translate3d(0, -50px, 0) rotate(0deg);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    50% {
      transform: translate3d(35px, 50vh, 0) rotate(180deg);
    }
    100% {
      transform: translate3d(-30px, 110vh, 0) rotate(360deg);
      opacity: 0;
    }
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 820px) {
    .offer-popup {
      width: min(100%, 720px);
    }

    .offer-right {
      padding: 26px 24px 20px;
    }
  }

  /* ---------- Mobile: stack panels ---------- */
  @media (max-width: 640px) {
    .offer-popup {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      width: min(100%, 420px);
      max-height: 88vh;
      overflow-y: auto;
    }

    .offer-left {
      padding: 22px 20px;
    }

    .gift-art {
      width: 48px;
      height: 48px;
      margin-bottom: 8px;
    }

    .discount-value {
      font-size: 34px;
    }

    .left-sub {
      font-size: 15px;
    }

    .left-divider {
      margin: 10px auto;
    }

    .wastage {
      font-size: 18px;
    }

    .offer-right {
      padding: 22px 18px 18px;
      overflow-y: visible;
    }

    .brand-label {
      font-size: 17px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gold-particle {
      animation: none;
    }

    .offer-popup {
      transition: none;
    }
  }
</style>