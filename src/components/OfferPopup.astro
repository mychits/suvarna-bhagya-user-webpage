
<script>
  const overlay = document.querySelector("#offerOverlay");
  const popup = overlay?.querySelector<HTMLElement>(".offer-popup");
  const closeButton = document.querySelector("#closeOffer");

  if (overlay && popup && closeButton) {
    // Hide the image if it is missing
    const offerImg = overlay.querySelector<HTMLImageElement>(".offer-image");

    if (offerImg) {
      const markMissing = () => offerImg.classList.add("is-missing");

      offerImg.addEventListener("error", markMissing);

      if (offerImg.complete && offerImg.naturalWidth === 0) {
        markMissing();
      }
    }

    let popupOpened = false;
    let firstPopupShown = false;
    let repeatTimer: ReturnType<typeof setTimeout> | null = null;

    const REPEAT_INTERVAL = 3 * 60 * 1000; // 3 minutes

    // Show popup
    const showPopup = () => {
      if (popupOpened) return;

      popupOpened = true;

      overlay.classList.add("is-visible");
      overlay.setAttribute("aria-hidden", "false");

      document.body.style.overflow = "hidden";

      popup.focus();
    };

    // Close popup
    const closePopup = () => {
      if (!popupOpened) return;

      popupOpened = false;

      overlay.classList.remove("is-visible");
      overlay.setAttribute("aria-hidden", "true");

      document.body.style.overflow = "";

      // Start the 3-minute repeat timer
      if (repeatTimer !== null) {
        clearTimeout(repeatTimer);
      }

      repeatTimer = setTimeout(() => {
        showPopup();
      }, REPEAT_INTERVAL);
    };

    // First popup: show after 20% page scroll
    const handleFirstScroll = () => {
      if (firstPopupShown) return;

      const scrollableHeight =
        document.documentElement.scrollHeight - window.innerHeight;

      if (scrollableHeight <= 0) return;

      const scrollPercentage =
        (window.scrollY / scrollableHeight) * 100;

      if (scrollPercentage >= 20) {
        firstPopupShown = true;

        window.removeEventListener("scroll", handleFirstScroll);

        showPopup();
      }
    };

    // Listen for the first 20% scroll
    window.addEventListener("scroll", handleFirstScroll, {
      passive: true
    });

    // Close button
    closeButton.addEventListener("click", closePopup);

    // Close when clicking outside popup
    overlay.addEventListener("click", (event) => {
      if (event.target === overlay) {
        closePopup();
      }
    });

    // Close using Escape key
    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        popupOpened
      ) {
        closePopup();
      }
    });
  }
</script>
