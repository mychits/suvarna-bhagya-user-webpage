---
import MainLayout from '../layouts/MainLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import AboutSection from '../components/AboutSection.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import SchemeCard from '../components/SchemeCard.astro';
import HowItWorks from '../components/HowItWorks.astro';
import AppPromoSection from '../components/AppPromoSection.astro';
import CompanyContribution from '../components/CompanyContribution.astro';
import HelpSection from '../components/HelpSection.astro';
import CTASection from '../components/CTASection.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import OfferPopup from '../components/OfferPopup.astro';
---

<MainLayout title="Home">
  <HeroSection />
  <OfferPopup />
  
  <AboutSection />
  
  <WhyChooseUs />
  
  <!-- Scheme Options -->
  <section class="schemes-overview" style="padding: 6rem 0; background: #fff;">
    <div class="container">
      <!-- Centered Heading -->
      <div class="section-header" style="text-align: center; margin-bottom: 3rem;">
        <span class="eyebrow" style="display: block; color: var(--color-gold-dark); font-size: 0.85rem; letter-spacing: 2px; font-weight: 600; margin-bottom: 0.5rem;">— SCHEME OPTIONS —</span>
        <h2 style="font-size: 2.2rem; color: var(--color-burgundy); margin: 0;">Choose Your Scheme</h2>
      </div>
      
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; max-width: 1000px; margin: 0 auto;">
        <SchemeCard 
          type="weight"
          title="Weight Based Scheme"
          subtitle="Every monthly installment is converted into gold at the applicable gold rate on the payment date. Your accumulated gold is redeemed against jewellery at maturity."
          features={[
            "Ideal for those who want to build gold over time",
            "Accumulates gold at today's rate every month",
            "Benefit from gold appreciation over time",
            "Redeem against jewellery at scheme maturity",
            "Cancel: refund minus 20% of one month's installment"
          ]}
        />
        <SchemeCard 
          type="amount"
          title="Amount Based Scheme"
          subtitle="Your monthly installments remain as money throughout the tenure. At maturity, the full accumulated amount is redeemed against jewellery."
          features={[
            "Ideal for those who prefer fixed monthly savings",
            "Fixed savings — installments retained as currency",
            "Predictable — no market dependency",
            "Full amount redeemable against jewellery",
            "Cancel: 100% refund of all deposited installments"
          ]}
        />
      </div>
    </div>
  </section>

  <HowItWorks />
  
  <AppPromoSection />
  
  <CompanyContribution />
  <CTASection />
  
  <HelpSection />
  <WhatsAppButton />
  
  
</MainLayout>