---
import MainLayout from '../layouts/MainLayout.astro';
import Plans from '../components/Plans.astro';
import Faqs from '../components/Faqs.astro';
---

<MainLayout title="Our Plans">
  <!-- Enhanced Page Header -->
  <div class="page-header">
    <div class="container header-content">
      <span class="eyebrow">— SAVINGS PLANS —</span>
      <h1>Compare Our Savings Plans</h1>
      <p>Find the perfect plan to start your gold savings journey.</p>
    </div>
    <div class="header-decor header-decor-left"></div>
    <div class="header-decor header-decor-right"></div>
  </div>
  
  <Plans />
  
  <!-- Enhanced Terms & Conditions Section -->
  <section class="terms-section">
    <div class="container">
      <div class="terms-header">
        <span class="eyebrow">— IMPORTANT —</span>
        <h2>Scheme Terms & Conditions</h2>
        <div class="gold-divider"></div>
      </div>
      <p class="terms-intro">Please review the following terms carefully before enrolling:</p>
      
      <div class="terms-grid">
        <div class="term-item">
          <div class="term-icon">01</div>
          <div class="term-text">
            <h3>Plan Illustrations</h3>
            <p>Plan amounts, duration, and bonuses are illustrative and subject to final approval.</p>
          </div>
        </div>
        <div class="term-item">
          <div class="term-icon">02</div>
          <div class="term-text">
            <h3>Redemption Eligibility</h3>
            <p>Eligibility for redemption (cash or jewellery) is subject to successful completion of all installments.</p>
          </div>
        </div>
        <div class="term-item">
          <div class="term-icon">03</div>
          <div class="term-text">
            <h3>Payment Policy</h3>
            <p>Missed payments may result in late fees or cancellation as per policy.</p>
          </div>
        </div>
        <div class="term-item">
          <div class="term-icon">04</div>
          <div class="term-text">
            <h3>KYC Requirement</h3>
            <p>KYC verification is mandatory for all enrolments.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <Faqs />
</MainLayout>

<style>
  /* ---------- PAGE HEADER ---------- */
  .page-header {
    background: linear-gradient(135deg, var(--color-burgundy) 0%, #5a0a22 100%);
    color: var(--color-ivory);
    padding: 6rem 0 5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .header-content {
    position: relative;
    z-index: 2;
    animation: fadeUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }

  .eyebrow {
    display: block;
    color: var(--color-gold);
    font-size: 0.85rem;
    letter-spacing: 3px;
    font-weight: 600;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .page-header h1 {
    color: var(--color-gold);
    font-size: 3.2rem;
    line-height: 1.15;
    margin: 0 0 1rem;
    font-family: var(--font-heading);
  }

  .page-header p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.15rem;
    max-width: 550px;
    margin: 0 auto;
  }

  /* Decorative circles */
  .header-decor {
    position: absolute;
    border-radius: 50%;
    background: var(--color-gold);
    opacity: 0.06;
    pointer-events: none;
  }
  .header-decor-left {
    width: 350px; height: 350px;
    top: -100px; left: -100px;
  }
  .header-decor-right {
    width: 250px; height: 250px;
    bottom: -80px; right: -80px;
    animation: floatSlow 8s ease-in-out infinite;
  }

  @keyframes floatSlow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }

  /* ---------- TERMS SECTION ---------- */
  .terms-section {
    padding: 6rem 0;
    background: var(--color-ivory, #f9f6f0);
  }

  .terms-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 1.5rem;
  }

  .terms-header .eyebrow {
    color: var(--color-gold-dark, #8c6825);
  }

  .terms-header h2 {
    color: var(--color-burgundy);
    font-size: 2.5rem;
    margin: 0.4rem 0 1rem;
  }

  .gold-divider {
    width: 70px;
    height: 2px;
    background: var(--color-gold);
    margin: 0 auto;
  }

  .terms-intro {
    text-align: center;
    color: #555;
    max-width: 600px;
    margin: 0 auto 3rem;
    font-size: 1.05rem;
  }

  .terms-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .term-item {
    background: #fff;
    border-radius: 12px;
    padding: 2rem;
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
    border: 1px solid transparent;
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
    animation: fadeUp 0.6s ease both;
  }

  .term-item:nth-child(1) { animation-delay: 0.05s; }
  .term-item:nth-child(2) { animation-delay: 0.15s; }
  .term-item:nth-child(3) { animation-delay: 0.25s; }
  .term-item:nth-child(4) { animation-delay: 0.35s; }

  .term-item:hover {
    transform: translateY(-6px);
    border-color: var(--color-gold);
    box-shadow: 0 14px 30px rgba(128, 0, 32, 0.1);
  }

  .term-icon {
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #fdf2eb;
    color: var(--color-burgundy);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.35s ease;
  }

  .term-item:hover .term-icon {
    background: var(--color-burgundy);
    color: var(--color-gold);
    transform: scale(1.1);
  }

  .term-text h3 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
    color: var(--color-charcoal);
    font-family: var(--font-body);
  }

  .term-text p {
    margin: 0;
    color: #666;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  /* ---------- GLOBAL ANIMATION KEYFRAME ---------- */
  @keyframes fadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 768px) {
    .page-header h1 { font-size: 2.2rem; }
    .terms-grid { grid-template-columns: 1fr; }
    .terms-header h2 { font-size: 2rem; }
    .terms-section { padding: 4rem 0; }
  }

  @media (max-width: 480px) {
    .page-header { padding: 4.5rem 0 4rem; }
    .page-header h1 { font-size: 1.8rem; }
    .term-item { padding: 1.5rem; }
  }
</style>