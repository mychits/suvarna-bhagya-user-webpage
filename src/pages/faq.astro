---
import MainLayout from '../layouts/MainLayout.astro';
import Faqs from '../components/Faqs.astro';
import { generateSEO } from '../utils/seo';
const seo = generateSEO('FAQs', 'Find answers to common questions about our gold savings schemes.');
---

<MainLayout title={seo.title} description={seo.description}>
  <!-- Enhanced Page Header -->
  <div class="page-header">
    <div class="container header-content">
      <span class="eyebrow">— HELP CENTER —</span>
      <h1>Frequently Asked Questions</h1>
      <p>Find quick answers to common questions about our gold savings schemes.</p>
    </div>
    <div class="header-decor header-decor-left"></div>
    <div class="header-decor header-decor-right"></div>
  </div>
  
  <Faqs />
  
  <!-- Enhanced Support CTA -->
  <section class="support-cta">
    <div class="container">
      <div class="support-card">
        <div class="support-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        </div>
        <h2>Still have questions?</h2>
        <p>Can't find the answer you're looking for? Our support team is here to help you with personalized assistance.</p>
        <a href="/contact" class="btn-primary support-btn">Contact Support</a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* ---------- PAGE HEADER ---------- */
  .page-header {
    background: linear-gradient(135deg, var(--color-burgundy) 0%, #5a0a22 100%);
    color: var(--color-ivory);
    padding: 6rem 0 5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .header-content {
    position: relative; z-index: 2;
    animation: fadeUp 0.8s ease-out forwards;
    opacity: 0; transform: translateY(20px);
  }
  .eyebrow {
    display: block; color: var(--color-gold);
    font-size: 0.85rem; letter-spacing: 3px; font-weight: 600;
    margin-bottom: 1rem; text-transform: uppercase;
  }
  .page-header h1 {
    color: var(--color-gold); font-size: 3.2rem;
    line-height: 1.15; margin: 0 0 1rem; font-family: var(--font-heading);
  }
  .page-header p {
    color: rgba(255, 255, 255, 0.85); font-size: 1.15rem;
    max-width: 550px; margin: 0 auto;
  }
  .header-decor {
    position: absolute; border-radius: 50%; background: var(--color-gold);
    opacity: 0.06; pointer-events: none;
  }
  .header-decor-left { width: 350px; height: 350px; top: -100px; left: -100px; }
  .header-decor-right {
    width: 250px; height: 250px; bottom: -80px; right: -80px;
    animation: floatSlow 8s ease-in-out infinite;
  }
  @keyframes floatSlow { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-20px); } }

  /* ---------- SUPPORT CTA ---------- */
  .support-cta {
    padding: 6rem 0;
    background: var(--color-ivory, #f9f6f0);
  }
  .support-card {
    background: #fff;
    max-width: 700px;
    margin: 0 auto;
    padding: 3.5rem 2.5rem;
    border-radius: 18px;
    text-align: center;
    border: 1px solid #f0e6d6;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.06);
    position: relative;
    overflow: hidden;
    animation: fadeUp 0.8s ease both 0.1s;
    opacity: 0; transform: translateY(20px);
  }
  /* Subtle gold decorative corner */
  .support-card::before {
    content: '';
    position: absolute;
    top: -60px; right: -60px;
    width: 200px; height: 200px;
    background: var(--color-gold);
    opacity: 0.05;
    border-radius: 50%;
    pointer-events: none;
  }
  .support-icon {
    width: 64px; height: 64px; border-radius: 50%;
    background: #fdf2eb; color: var(--color-burgundy);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 1.5rem;
    transition: all 0.35s ease;
  }
  .support-icon svg { width: 30px; height: 30px; }
  .support-card:hover .support-icon {
    background: var(--color-burgundy); color: var(--color-gold);
    transform: scale(1.08) rotate(-5deg);
  }
  .support-card h2 {
    color: var(--color-burgundy);
    font-size: 2rem;
    margin: 0 0 0.8rem;
    font-family: var(--font-heading);
  }
  .support-card p {
    color: #666;
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 480px;
    margin: 0 auto 2rem;
  }
  .support-btn {
    background: var(--color-burgundy);
    color: #fff;
    padding: 0.9rem 2.2rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1rem;
    display: inline-block;
    transition: all 0.3s ease;
  }
  .support-btn:hover {
    background: var(--color-gold);
    color: var(--color-burgundy);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(212, 175, 55, 0.35);
  }

  /* ---------- GLOBAL ANIMATION ---------- */
  @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 768px) {
    .page-header h1 { font-size: 2.4rem; }
    .support-cta { padding: 4rem 0; }
    .support-card { padding: 2.5rem 1.5rem; }
  }
  @media (max-width: 480px) {
    .page-header { padding: 4.5rem 0 4rem; }
    .page-header h1 { font-size: 1.9rem; }
    .support-card h2 { font-size: 1.6rem; }
  }
</style>