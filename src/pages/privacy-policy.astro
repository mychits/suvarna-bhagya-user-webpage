---
import MainLayout from '../layouts/MainLayout.astro';
import { generateSEO } from '../utils/seo';

const seo = generateSEO(
  'Privacy Policy',
  'Read our privacy policy to understand how we protect your data.'
);

const sections = [
  {
    title: 'Information We Collect',
    text: 'We collect personal information such as your name, mobile number, email address, and KYC documents (PAN, Aadhaar) when you register on our platform.',
  },
  {
    title: 'How We Use Your Information',
    text: 'Your information is used to process enrolments, verify your identity for KYC compliance, manage your savings account, and communicate important updates regarding your scheme.',
  },
  {
    title: 'Data Security',
    text: 'We implement industry-standard security measures, including encryption and secure S3-compatible document storage, to protect your personal and financial data from unauthorized access.',
  },
  {
    title: 'Third-Party Sharing',
    text: 'We do not sell your data. We may share necessary information with payment gateways (like Razorpay) and KYC verification partners strictly for processing your transactions and compliance.',
  },
  {
    title: 'Your Rights',
    text: 'You have the right to access, correct, or request deletion of your personal data, subject to legal and regulatory retention requirements.',
  },
];
---

<MainLayout title={seo.title} description={seo.description}>
  <!-- Page Header -->
  <div class="page-header">
    <div class="container header-content">
      <span class="eyebrow">— LEGAL —</span>
      <h1>Privacy Policy</h1>
      <p>How Suvarna Bhagya collects, uses and protects your information.</p>
    </div>
    <div class="header-decor header-decor-left"></div>
    <div class="header-decor header-decor-right"></div>
  </div>

  <!-- Content -->
  <div class="policy-wrap">
    <div class="container">
      <article class="policy-card">
        <p class="updated">Last updated: November 2026</p>

        {sections.map((section, index) => (
          <section class="policy-section">
            <div class="section-title">
              <span class="section-num">{index + 1}</span>
              <h2>{section.title}</h2>
            </div>
            <p>{section.text}</p>
          </section>
        ))}

        <div class="policy-contact">
          <div>
            <strong>Questions about your data?</strong>
            <span>Our team is happy to help with any privacy concern.</span>
          </div>
          <a href="/contact" class="contact-btn">Contact Us</a>
        </div>
      </article>
    </div>
  </div>
</MainLayout>

<style>
  /* ---------- PAGE HEADER ---------- */
  .page-header {
    background: linear-gradient(135deg, var(--color-burgundy) 0%, #5a0a22 100%);
    color: var(--color-ivory);
    padding: 6rem 0 5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .header-content {
    position: relative;
    z-index: 2;
    animation: fadeUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }
  .eyebrow {
    display: block;
    color: var(--color-gold);
    font-size: 0.85rem;
    letter-spacing: 3px;
    font-weight: 600;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }
  .page-header h1 {
    color: var(--color-gold);
    font-size: 3.2rem;
    line-height: 1.15;
    margin: 0 0 1rem;
    font-family: var(--font-heading);
  }
  .page-header p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.15rem;
    max-width: 550px;
    margin: 0 auto;
  }
  .header-decor {
    position: absolute;
    border-radius: 50%;
    background: var(--color-gold);
    opacity: 0.06;
    pointer-events: none;
  }
  .header-decor-left {
    width: 350px;
    height: 350px;
    top: -100px;
    left: -100px;
  }
  .header-decor-right {
    width: 250px;
    height: 250px;
    bottom: -80px;
    right: -80px;
    animation: floatSlow 8s ease-in-out infinite;
  }
  @keyframes floatSlow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }

  /* ---------- POLICY CONTENT ---------- */
  .policy-wrap {
    background: var(--color-ivory, #f9f6f0);
    padding: 5rem 0 6rem;
  }

  .policy-card {
    max-width: 860px;
    margin: 0 auto;
    background: #fff;
    padding: 3rem 3.2rem;
    border-radius: 16px;
    border: 1px solid #f0e6d6;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
    animation: fadeUp 0.8s ease both 0.2s;
    opacity: 0;
    transform: translateY(20px);
  }

  .updated {
    display: inline-block;
    margin: 0 0 2rem;
    padding: 0.4rem 1rem;
    background: #fdf2eb;
    color: var(--color-gold-dark, #9a7627);
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  .policy-section {
    padding: 1.6rem 0;
    border-bottom: 1px solid #f0e6d6;
  }
  .policy-section:first-of-type {
    padding-top: 0;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 0.7rem;
  }

  .section-num {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--color-burgundy);
    color: var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .policy-section h2 {
    color: var(--color-burgundy);
    font-family: var(--font-heading);
    font-size: 1.35rem;
    margin: 0;
  }

  .policy-section p {
    margin: 0 0 0 calc(34px + 0.9rem);
    color: #555;
    font-size: 1rem;
    line-height: 1.8;
  }

  /* Contact strip */
  .policy-contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2rem;
    padding: 1.4rem 1.6rem;
    background: #fdf8eb;
    border-left: 3px solid var(--color-gold);
    border-radius: 0 10px 10px 0;
  }

  .policy-contact strong {
    display: block;
    color: var(--color-burgundy);
    font-size: 1rem;
    margin-bottom: 0.2rem;
  }

  .policy-contact span {
    color: #75502b;
    font-size: 0.9rem;
  }

  .contact-btn {
    flex-shrink: 0;
    padding: 0.7rem 1.6rem;
    background: var(--color-burgundy);
    color: #fff;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
  }

  .contact-btn:hover {
    background: var(--color-gold);
    color: var(--color-burgundy);
    transform: translateY(-2px);
  }

  /* ---------- ANIMATION ---------- */
  @keyframes fadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 900px) {
    .page-header h1 {
      font-size: 2.4rem;
    }
    .policy-wrap {
      padding: 3.5rem 0 4rem;
    }
    .policy-card {
      padding: 2.2rem 1.8rem;
    }
  }

  @media (max-width: 600px) {
    .policy-section p {
      margin-left: 0;
    }
    .policy-contact {
      flex-direction: column;
      align-items: flex-start;
    }
    .contact-btn {
      width: 100%;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .page-header {
      padding: 4.5rem 0 4rem;
    }
    .page-header h1 {
      font-size: 1.9rem;
    }
    .policy-card {
      padding: 1.6rem 1.2rem;
    }
    .policy-section h2 {
      font-size: 1.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-content,
    .policy-card {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .header-decor-right {
      animation: none;
    }
  }
</style>